<!DOCTYPE html>
<html>
   <head>
         <meta charset="utf-8">
         <meta name="viewport" content="width=device-width">
         <title>replite</title>
         <link herf="style,css" rel="stylesheet" type="text/css" />
       </head>
       <body>
            <form>
                <fieldset>
                    <!--The fieldset tag is used to grow related
    elements in a form and draws a box around them-->
                  <legend>Personal Information:</legend>
                  <label>Full name:</label>
                  <!--placeholder attribute can used to provide
    extra information about entry to be made-->
    Name"><br><br>
                      <label>Email:</label>
                      <input type="text" id="email"><br><br>
                      <label>Gender:</label><br>
                      <input type="radio" id="gender"
    value="female">Female<br>
                      <input type="radio" id="gender"
    value="male">Male<br><b>
                     <label>Birthday:</label>
                     <input type="date" id="birthday" name="birthday">
    <br><br>
                      </fieldset>
                </form>
            </body>
        </html>

                
  